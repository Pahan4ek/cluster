# Copy to .env and fill in. .env is gitignored.

# --- data source (live scorer) ---
# Solami: Mirage stream is the default source when this is set (Standard key: MirageStream + MirageManage)
SOLAMI_API_KEY=
# SOLAMI_MIRAGE_ID=        existing Mirage subscription id (otherwise "clusterpulse-pump" is created)
# Fallback logsSubscribe source
HELIUS_API_KEY=
# WS_URL=wss://...         any Solana WebSocket for logsSubscribe
# RPC_URL=https://...      any Solana RPC for refetching truncated transactions

# --- alerts ---
TG_BOT_TOKEN=
TG_CHAT_ID=
# ALERT_LANG=en            en | ru
# DECIDE_AFTER=12
# MIN_WALLETS_ALERT=3
# MODEL_PATH=model/live_model.json

# --- retraining (retro/) ---
DUNE_API_KEY=
